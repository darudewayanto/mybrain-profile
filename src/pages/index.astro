---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import Icon from "../components/Icon.astro";
import Badge from "../components/Badge.astro";
import QuadrantExplorer from "../components/QuadrantExplorer.astro";
import CtaBand from "../components/CtaBand.astro";
import Testimonials from "../components/Testimonials.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import { u } from "../lib/url";
import { wa, services, stats, problems } from "../data/site";

import heroPhoto from "../assets/photos/shoe-hd.jpg";
import heroCutout from "../assets/photos/shoe-cutout.png";
import LensCard from "../components/LensCard.astro";
import reflectionPhoto from "../assets/photos/lens-reflection.png";

const outcomes = [
  "Memahami cara otak Anda memproses informasi & mengambil keputusan",
  "Mengenali potensi terbaik — dan blind-spot yang perlu diantisipasi",
  "Berkomunikasi & berkolaborasi lebih efektif dengan tipe yang berbeda",
  "Menyusun tim yang seimbang dan saling melengkapi",
];

const lenses = [
  { kind: "idea", alt: "Dua burung di atas kabel dengan latar kuning — idea, detail, logic, harmony", title: "Harmoni 4 Kuadran", text: "Ide, detail, logika, dan harmoni — melihat diri secara utuh." },
  { kind: "optimizing", alt: "Kaki bersepatu warna-warni terangkat ke langit biru — optimizing potential", title: "Optimizing Potential", text: "Mengoptimalkan kekuatan alami yang sudah Anda miliki." },
  { kind: "reflection", alt: "Seseorang memegang cermin berbentuk lengkung di depan dinding merah — reflection", title: "Reflection", text: "Cermin yang jujur tentang cara Anda berpikir dan bertindak." },
  { kind: "anticipating", alt: "Tiga potong jeruk bertumpuk di latar biru — anticipating blind-spot", title: "Anticipating Blind-spot", text: "Mengantisipasi titik buta sebelum menjadi hambatan." },
];

const steps = [
  { n: "01", title: "Isi kuesioner", text: "Kuesioner MyBrain singkat yang dapat diisi secara online, kapan saja." },
  { n: "02", title: "Terima profil", text: "Profil 4 kuadran yang memetakan neuro-dominance Anda atau tim." },
  { n: "03", title: "Sesi interpretasi", text: "Practitioner tersertifikasi membedah hasil dan rencana pengembangannya." },
];
---
<Base>
  <!-- ============ HERO ============ -->
  <section class="hero sand">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Applied-Neuroscience Profiling</p>
        <h1 class="hero-title">Kenali Cara Otak Anda <span class="t-orange">Bekerja.</span></h1>
        <p class="lead">MyBrain menggabungkan <em>physiology</em> dan <em>psychology</em> untuk memetakan bagaimana Anda berpikir, merasa, dan bertindak — berbasis sains, bukan ramalan.</p>
        <div class="actions">
          <a class="btn btn-orange" href={wa("individual")} target="_blank" rel="noopener">Mulai Profiling <Icon name="arrow-right" size={18} /></a>
          <a class="btn btn-ghost" href={u("/metode")}>Pelajari Metode</a>
        </div>
        <p class="licence"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span> Lisensi resmi MyBrain, United Kingdom</p>
      </div>

      <div class="hero-art">
        <div class="hero-circle">
          <Image src={heroPhoto} alt="Kaki bersepatu warna-warni terangkat ke langit biru" widths={[600, 1089]} sizes="(min-width: 900px) 590px, 100vw" loading="eager" fetchpriority="high" />
        </div>
        <!-- Same photo, cut out and aligned on top: only the part above the centre shows, so the shoe breaks out of the frame. -->
        <Image src={heroCutout} alt="" aria-hidden="true" class="hero-pop" widths={[600, 1089]} sizes="(min-width: 900px) 590px, 100vw" loading="eager" />
        <span class="sticker word" aria-hidden="true">optimizing<br />potential</span>
        <div class="hero-badge"><Badge text="MYBRAIN • INDONESIA •" icon="brain" color="var(--navy)" size={118} /></div>
      </div>
    </div>
  </section>

  <!-- ============ SERVICE STRIP ============ -->
  <nav class="strip" aria-label="Layanan">
    <div class="wrap strip-grid">
      {services.map((s) => (
        <a href={u(`/layanan#${s.key}`)} class="strip-item">
          <Icon name={s.icon} size={26} />
          <span>{s.title}</span>
        </a>
      ))}
    </div>
  </nav>

  <!-- ============ INTRO / OUTCOMES ============ -->
  <section class="section intro">
    <div class="wrap narrow" data-reveal>
      <p class="q">Sudah ikut banyak profiling, tapi masih belum benar-benar memahami diri sendiri?</p>
      <p class="q strong">Kami bisa membantu.</p>
      <h2 class="h2 intro-title">MyBrain memetakan <span class="t-navy nowrap"><em>neuro-dominance</em></span> Anda, agar Anda dapat bertumbuh, memimpin, dan bekerja sama dengan lebih jernih.</h2>
      <p class="sub">Dengan MyBrain, individu dan tim belajar untuk:</p>
      <ul role="list" class="checks">
        {outcomes.map((o) => <li><span class="tick"><Icon name="check" size={16} /></span>{o}</li>)}
      </ul>
      <a class="btn btn-orange" href={u("/metode")}>Lihat Cara Kerjanya <Icon name="arrow-right" size={18} /></a>
    </div>
  </section>

  <!-- ============ SERVICES (navy) ============ -->
  <section class="section navy services">
    <div class="wrap">
      <div class="head" data-reveal>
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <h2 class="h2">Layanan untuk individu & organisasi</h2>
      </div>
      <div class="svc-grid">
        {services.map((s) => (
          <article class="svc" data-reveal>
            <Badge text={s.badge} icon={s.icon} color={s.color} size={136} />
            <h3>{s.title}</h3>
            <p class="kicker">{s.kicker}</p>
            <p>{s.summary}</p>
            <a class="link-arrow" href={u(`/layanan#${s.key}`)}>Selengkapnya <Icon name="arrow-right" size={16} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PROBLEM ============ -->
  <section class="section cream problem">
    <div class="wrap problem-grid">
      <div class="problem-copy" data-reveal>
        <p class="eyebrow">Masalah yang kami selesaikan</p>
        <h2 class="h2">Profiling personal dan profesional harusnya <span class="t-olive">menjelaskan</span>, bukan menghakimi.</h2>
        <p class="lead">MyBrain mengisi absennya layanan yang lengkap di area human profiling dan applied-neuroscience psychometric.</p>
        <div class="problems">
          {problems.map((p) => (
            <article class={`pcard tone-${p.tone}`}>
              <h3>{p.title},<br />{p.sub}</h3>
              <p>{p.text}</p>
              <p class="pq">{p.quote}</p>
            </article>
          ))}
        </div>
      </div>
      <figure class="problem-photo" data-reveal>
        <Image src={reflectionPhoto} alt="Seseorang memegang cermin di depan dinding merah — reflection" widths={[360, 413]} sizes="(min-width: 960px) 30vw, 70vw" />
      </figure>
    </div>
  </section>

  <!-- ============ QUADRANTS ============ -->
  <section class="section quad">
    <div class="wrap">
      <div class="head center" data-reveal>
        <p class="eyebrow">Profiling Concept</p>
        <h2 class="h2">Empat Kuadran <span class="t-orange">Neurological-<wbr />Dominance</span></h2>
        <p class="lead">Pilih satu kuadran untuk melihat bagaimana ia memengaruhi cara Anda berpikir dan bekerja.</p>
      </div>
      <div data-reveal><QuadrantExplorer /></div>
    </div>
  </section>

  <!-- ============ LENSES (campaign art) ============ -->
  <section class="section sand lenses">
    <div class="wrap">
      <div class="head" data-reveal>
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <h2 class="h2">Empat cara melihat diri Anda</h2>
      </div>
    </div>
    <div class="lens-row">
      {lenses.map((l, i) => (
        <figure class="lens" style={`--d:${i * 90}ms`} data-reveal>
          <LensCard kind={l.kind as "idea"} />
          <span class="sr-only">{l.alt}</span>
          <figcaption><strong>{l.title}</strong><span>{l.text}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="section steps">
    <div class="wrap">
      <div class="head" data-reveal>
        <p class="eyebrow">Cara kerja</p>
        <h2 class="h2">Tiga langkah menuju <span class="t-olive">kejernihan</span></h2>
      </div>
      <ol role="list" class="step-grid">
        {steps.map((s) => (
          <li class="step" data-reveal>
            <span class="n">{s.n}</span>
            <h3 class="h3">{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ CLIENTS + TESTIMONIALS ============ -->
  <section class="clients">
    <div class="wrap clients-head" data-reveal>
      <div>
        <p class="eyebrow">Dipercaya oleh</p>
        <h2 class="h2">Klien ekosistem <span class="t-navy">MyBrain Indonesia</span> &amp; HADE</h2>
      </div>
      <p class="lead">BUMN, kementerian, hingga perusahaan global telah mempercayakan pengembangan leader dan timnya kepada kami.</p>
    </div>
    <LogoMarquee />
  </section>
  <Testimonials />

  <!-- ============ STATS ============ -->
  <section class="stats navy">
    <div class="wrap stat-grid">
      {stats.map((s) => (
        <div class="stat" data-reveal>
          <strong>{s.value}</strong>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <CtaBand from="var(--navy)" />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { padding-block: clamp(2rem, 5vw, 4.5rem) clamp(3rem, 6vw, 5rem); overflow: hidden; }
  .hero-grid { display: grid; gap: 3rem; align-items: center; }
  .hero-copy { display: grid; gap: 1.4rem; justify-items: start; }
  .hero-copy .eyebrow { color: var(--olive-deep); }
  .hero-title { font-size: var(--fs-hero); font-weight: 900; letter-spacing: -0.045em; line-height: 0.98; max-width: 11ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .licence { display: flex; align-items: center; gap: 0.75rem; font-size: 0.85rem; font-weight: 600; color: var(--ink-soft); }

  /* The photo is drawn 1.35× the circle and shifted up so the shoe sits above the frame;
     the cut-out copy uses identical geometry, so the two line up exactly. */
  .hero-art {
    --k: 1.35; --top: -63%;
    position: relative; justify-self: center; width: min(78%, 440px);
    margin-top: 24%;
  }
  .hero-circle {
    position: relative; aspect-ratio: 1; border-radius: 50%; overflow: hidden;
    background: var(--sky);
    box-shadow: 0 0 0 10px var(--paper), 0 30px 60px -30px rgba(15, 19, 51, 0.6);
  }
  .hero-art :global(img) {
    position: absolute; max-width: none; height: auto;
    width: calc(var(--k) * 100%); left: calc((1 - var(--k)) * 50%); top: var(--top);
  }
  .hero-art :global(.hero-pop) {
    pointer-events: none;
    /* Image is 1.35 × 1.229 ≈ 1.66 circle-heights tall and starts 0.63 above it,
       so the circle's centre line sits ~68% down the image: hide everything below that. */
    clip-path: inset(-5% -5% 32% -5%);
  }
  .sticker {
    z-index: 2; position: absolute; top: 40%; right: -12%;
    padding: 0.5rem 1.1rem 0.6rem;
    background: var(--olive); color: #fff;
    border-radius: 18px;
    font-size: clamp(1.5rem, 3.5vw, 2.1rem);
    transform: rotate(-8deg);
    box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.35);
    animation: bob 5s ease-in-out infinite;
  }
  .hero-badge { z-index: 2; position: absolute; left: -8%; bottom: 0; }
  @media (max-width: 600px) { .hero-badge { transform: scale(0.72); transform-origin: left bottom; left: -4%; } }
  @keyframes bob { 50% { transform: rotate(-5deg) translateY(-6px); } }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.15fr 1fr; } }

  /* ---------- Strip ---------- */
  .strip { background: var(--sun); }
  .strip-grid { display: grid; grid-template-columns: repeat(2, 1fr); }
  .strip-item {
    display: flex; align-items: center; justify-content: center; gap: 0.7rem;
    padding: 1.4rem 0.75rem; font-weight: 700; font-size: 0.92rem; color: var(--navy-deep);
    line-height: 1.2; transition: background 0.2s;
  }
  .strip-item:hover { background: rgba(255, 255, 255, 0.25); }
  .strip-item :global(svg) { flex: none; }
  @media (min-width: 860px) {
    .strip-grid { grid-template-columns: repeat(4, 1fr); }
    .strip-item + .strip-item { border-left: 2px solid rgba(255, 255, 255, 0.7); }
    .strip-item { margin-block: 1rem; padding-block: 0.6rem; }
  }
  @media (max-width: 859px) {
    .strip-item:nth-child(odd) { border-right: 2px solid rgba(255, 255, 255, 0.7); }
    .strip-item:nth-child(-n+2) { border-bottom: 2px solid rgba(255, 255, 255, 0.7); }
  }

  /* ---------- Intro ---------- */
  .narrow { max-width: 820px; display: grid; justify-items: center; text-align: center; gap: 1.25rem; }
  .q { font-weight: 600; color: var(--navy); max-width: 36ch; }
  .q.strong { font-weight: 800; margin-top: -0.5rem; }
  .intro-title { font-size: clamp(1.6rem, 1.1rem + 2vw, 2.6rem); margin-block: 0.75rem 0.5rem; }
  .sub { font-weight: 700; color: var(--navy); }
  .checks { display: grid; gap: 1rem 2.5rem; text-align: left; margin-bottom: 1rem; }
  @media (min-width: 720px) { .checks { grid-template-columns: 1fr 1fr; } }
  .checks li { display: flex; gap: 0.8rem; align-items: flex-start; font-size: 0.95rem; color: var(--ink-soft); }
  .tick { flex: none; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--olive); color: #fff; margin-top: 0.1rem; }

  /* ---------- Section heads ---------- */
  .head { display: grid; gap: 1rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); max-width: 720px; }
  .head.center { margin-inline: auto; text-align: center; justify-items: center; }
  .head .eyebrow { color: var(--olive-deep); }

  /* ---------- Services ---------- */
  .services .head { margin-inline: auto; text-align: center; justify-items: center; }
  .svc-grid { display: grid; gap: 3rem 2rem; }
  @media (min-width: 640px) { .svc-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1080px) { .svc-grid { grid-template-columns: repeat(4, 1fr); } }
  .svc { display: grid; justify-items: center; text-align: center; gap: 0.6rem; align-content: start; }
  .svc :global(.badge) { margin-bottom: 0.75rem; transition: transform 0.4s var(--ease); }
  .svc:hover :global(.badge) { transform: scale(1.06) rotate(-4deg); }
  .svc h3 { font-size: 1.3rem; }
  .kicker { font-size: 0.8rem; font-weight: 700; color: var(--sun); letter-spacing: 0.02em; }
  .svc p:not(.kicker) { font-size: 0.9rem; color: rgba(255, 255, 255, 0.75); max-width: 30ch; }
  .svc .link-arrow { margin-top: 0.4rem; }
  .svc .link-arrow:hover { color: var(--sun); }

  /* ---------- Problem ---------- */
  .problem-grid { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 960px) { .problem-grid { grid-template-columns: 1.6fr 1fr; } }
  .problem-copy { display: grid; gap: 1.25rem; }
  .problem-copy .eyebrow { color: var(--olive-deep); }
  .problems { display: grid; gap: 1rem; margin-top: 1rem; }
  @media (min-width: 640px) { .problems { grid-template-columns: repeat(3, 1fr); } }
  .pcard { display: grid; gap: 0.6rem; align-content: start; }
  .pcard h3 {
    padding: 0.85rem 1rem; border-radius: 10px; color: #fff; text-align: center;
    font-size: 1.15rem; letter-spacing: -0.01em; line-height: 1.15;
  }
  .pcard.tone-olive h3 { background: var(--olive); }
  .pcard.tone-navy h3 { background: var(--navy); }
  .pcard.tone-orange h3 { background: var(--orange); }
  .pcard p { font-size: 0.88rem; color: var(--ink-soft); padding-inline: 0.25rem; }
  .pcard .pq { font-style: italic; font-weight: 600; color: var(--ink); }
  .problem-photo { justify-self: center; width: min(100%, 340px); }
  .problem-photo :global(img) { width: 100%; height: auto; border-radius: var(--radius-lg); box-shadow: var(--shadow); }

  /* ---------- Quadrants ---------- */
  .quad { background: var(--paper); }

  /* ---------- Lenses ---------- */
  .lens-row {
    display: grid; grid-auto-flow: column; grid-auto-columns: min(72vw, 300px);
    gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 0 var(--gutter) 1rem; scroll-padding-inline: var(--gutter); scrollbar-width: none;
  }
  .lens-row::-webkit-scrollbar { display: none; }
  @media (min-width: 900px) {
    .lens-row { grid-auto-flow: row; grid-template-columns: repeat(4, 1fr); overflow: visible; width: min(100% - 2 * var(--gutter), var(--wrap)); margin-inline: auto; padding: 0; }
  }
  .lens { scroll-snap-align: start; display: grid; gap: 0.9rem; transition-delay: var(--d); }
  .lens :global(.lens-card) { transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .lens:hover :global(.lens-card) { transform: translateY(-8px); box-shadow: var(--shadow); }
  .lens figcaption { display: grid; gap: 0.2rem; font-size: 0.88rem; color: var(--ink-soft); }
  .lens strong { color: var(--ink); font-size: 1rem; }

  /* ---------- Clients ---------- */
  .clients { background: var(--cream); padding-block: var(--section) clamp(2rem, 4vw, 3rem); }
  .clients-head { display: grid; gap: 1rem 3rem; align-items: end; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .clients-head .eyebrow { color: var(--olive-deep); margin-bottom: 0.75rem; }
  .clients-head .h2 { max-width: 18ch; }
  @media (min-width: 960px) { .clients-head { grid-template-columns: 1.2fr 1fr; } }

  /* ---------- Steps ---------- */
  .step-grid { display: grid; gap: 1.25rem; counter-reset: s; }
  @media (min-width: 820px) { .step-grid { grid-template-columns: repeat(3, 1fr); } }
  .step {
    position: relative; display: grid; gap: 0.6rem; align-content: start;
    padding: 2rem; border-radius: var(--radius-lg); background: var(--cream);
  }
  .step .n { font-family: var(--font-word); font-size: 3.4rem; line-height: 1; color: var(--orange); }
  .step:nth-child(2) .n { color: var(--olive); }
  .step:nth-child(3) .n { color: var(--navy); }
  .step p { color: var(--ink-soft); font-size: 0.95rem; }

  /* ---------- Stats ---------- */
  .stats { padding-block: clamp(3rem, 6vw, 4.5rem) clamp(1rem, 3vw, 2rem); }
  .stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 1.5rem; }
  @media (min-width: 860px) { .stat-grid { grid-template-columns: repeat(4, 1fr); } }
  .stat { display: grid; gap: 0.35rem; border-left: 3px solid var(--sun); padding-left: 1rem; }
  .stat strong { font-size: clamp(2.2rem, 4vw, 3.2rem); font-weight: 900; letter-spacing: -0.04em; line-height: 1; }
  .stat span { font-size: 0.85rem; color: rgba(255, 255, 255, 0.72); }
</style>
