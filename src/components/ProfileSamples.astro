---
// Sample Individual & Team profiles — the client's own files, served untouched (no resizing or re-encoding).
// Shown side by side at the same height and never wider than their native pixels, so they stay sharp.
import individual from "../assets/photos/profile-individual-original.png";
import team from "../assets/photos/profile-team-original.png";
---
<div class="samples" style={`--wi:${individual.width}; --wt:${team.width}`}>
  <img
    src={individual.src}
    width={individual.width}
    height={individual.height}
    loading="lazy"
    alt="Contoh Individual Profile MyBrain: Personal Profile dan Professional Profile berdampingan"
  />
  <img
    src={team.src}
    width={team.width}
    height={team.height}
    loading="lazy"
    alt="Contoh Team Profile MyBrain: profil tim di atas otak dan grafik sebaran skor Reasoning, Spontaneous, Specific, dan Feeling"
  />
</div>

<style>
  .samples { display: grid; gap: 1.25rem; justify-items: center; }
  .samples img { width: 100%; height: auto; display: block; }
  .samples img:first-child { max-width: calc(var(--wi) * 1px); }
  .samples img:last-child { max-width: calc(var(--wt) * 1px); }
  /* Side by side: flex-grow proportional to each file's width keeps both at the same height,
     and the row is capped at the files' combined native width so nothing is upscaled. */
  @media (min-width: 900px) {
    .samples {
      display: flex; align-items: flex-start; gap: 1.25rem;
      max-width: calc((var(--wi) + var(--wt)) * 1px + 1.25rem);
      margin-inline: auto;
    }
    .samples img { min-width: 0; flex-basis: 0; }
    .samples img:first-child { flex-grow: var(--wi); }
    .samples img:last-child { flex-grow: var(--wt); }
  }
</style>
