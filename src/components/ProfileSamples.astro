---
// Sample Individual & Team profiles, cropped as-is from the company profile slide ("Brain Instrument").
import { Image } from "astro:assets";
import individual from "../assets/photos/profile-individual.jpg";
import team from "../assets/photos/profile-team.jpg";
---
<div class="samples">
  <figure class="card">
    <Image
      src={individual}
      alt="Contoh Individual Profile MyBrain: Reasoning 32%, Spontaneous 35%, Specific 19%, Feeling 14%"
      widths={[500, 900, 1400]}
      sizes="(min-width: 900px) 34vw, 90vw"
    />
    <figcaption>Komposisi dominansi satu orang</figcaption>
  </figure>

  <figure class="card">
    <Image
      src={team}
      alt="Contoh Team Profile MyBrain: profil tim di atas otak dan grafik sebaran skor Reasoning, Spontaneous, Specific, dan Feeling untuk seluruh anggota tim"
      widths={[700, 1200, 2000]}
      sizes="(min-width: 900px) 56vw, 90vw"
    />
    <figcaption>Sebaran kuadran seluruh anggota tim</figcaption>
  </figure>
</div>

<style>
  .samples { display: grid; gap: 1.25rem; align-items: start; }
  @media (min-width: 900px) { .samples { grid-template-columns: 1fr 1.65fr; } }
  .card {
    display: grid; gap: 1rem; margin: 0;
    padding: clamp(1rem, 2.5vw, 1.75rem); border-radius: var(--radius-lg);
    background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow);
  }
  .card :global(img) { width: 100%; height: auto; }
  figcaption { font-size: 0.85rem; color: var(--muted); text-align: center; }
</style>
