---
// Circular badge with text running around the rim (after the reference site's seals).
import Icon from "./Icon.astro";
interface Props { text: string; icon: string; color: string; size?: number; spin?: boolean }
const { text, icon, color, size = 150, spin = true } = Astro.props;
const id = `badge-${Math.random().toString(36).slice(2, 8)}`;
---
<div class:list={["badge", { spin }]} style={`--c:${color}; --s:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 200 200" class="ring">
    <defs>
      <path id={id} d="M100,100 m-70,0 a70,70 0 1,1 140,0 a70,70 0 1,1 -140,0" />
    </defs>
    <!-- scalloped seal edge -->
    <circle cx="100" cy="100" r="96" fill="var(--c)" />
    <circle cx="100" cy="100" r="96" fill="none" stroke="var(--c)" stroke-width="8" stroke-dasharray="6 6" />
    <circle cx="100" cy="100" r="50" fill="none" stroke="rgba(255,255,255,.55)" stroke-width="1.5" />
    <g class="text">
      <text font-size="17" font-weight="700" letter-spacing="3.2" fill="#fff">
        <textPath href={`#${id}`} textLength="430">{text} {text}</textPath>
      </text>
    </g>
  </svg>
  <span class="icon"><Icon name={icon} size={Math.round(size * 0.22)} /></span>
</div>

<style>
  .badge { position: relative; width: var(--s); height: var(--s); flex: none; }
  .ring { width: 100%; height: 100%; }
  .icon { position: absolute; inset: 0; display: grid; place-items: center; color: #fff; }
  .text { transform-origin: 100px 100px; }
  .spin .text { animation: rot 22s linear infinite; }
  @keyframes rot { to { transform: rotate(360deg); } }
</style>
