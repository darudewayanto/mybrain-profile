---
import Icon from "./Icon.astro";
import { wa } from "../data/site";
---
<a class="fab" href={wa("general")} target="_blank" rel="noopener" aria-label="Chat dengan MyBrain Indonesia via WhatsApp">
  <Icon name="whatsapp" size={24} />
  <span>Tanya via WhatsApp</span>
</a>

<style>
  .fab {
    position: fixed;
    right: clamp(0.9rem, 2vw, 1.5rem);
    bottom: clamp(0.9rem, 2vw, 1.5rem);
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem;
    border-radius: 999px;
    background: #25d366;
    color: #fff;
    box-shadow: 0 14px 30px -10px rgba(15, 19, 51, 0.5);
    font-size: 0.85rem;
    font-weight: 600;
    transition: transform 0.25s var(--ease), background 0.25s;
  }
  .fab:hover { transform: translateY(-2px); background: #1ebe5b; }
  .fab span { display: none; padding-right: 0.35rem; }
  @media (min-width: 720px) { .fab span { display: inline; } .fab { padding: 0.75rem 1.05rem 0.75rem 0.85rem; } }
</style>
