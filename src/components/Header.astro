---
import { u } from "../lib/url";
import { Image } from "astro:assets";
import logo from "../assets/brand/mybrain-logo.png";
import Icon from "./Icon.astro";
import { nav, wa } from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, "") || "/";
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<header class="site-header" data-header>
  <div class="bar wrap">
    <a href={u("/")} class="brand" aria-label="MyBrain Indonesia — beranda">
      <Image src={logo} alt="" width={96} loading="eager" />
      <span class="brand-text">MyBrain<br /><b>Indonesia</b></span>
    </a>

    <nav class="links" aria-label="Utama">
      {nav.map((n) => (
        <a href={u(n.href)} class:list={[{ active: isActive(n.href) }]} aria-current={isActive(n.href) ? "page" : undefined}>
          {n.label}
        </a>
      ))}
    </nav>

    <a href={wa("general")} target="_blank" rel="noopener" class="cta">Konsultasi Gratis</a>

    <button class="toggle" aria-expanded="false" aria-controls="mobile-nav" data-toggle>
      <span class="sr-only">Buka menu</span>
      <Icon name="menu" size={22} class="i-open" />
      <Icon name="close" size={22} class="i-close" />
    </button>
  </div>

  <div class="mobile wrap" id="mobile-nav" data-mobile hidden>
    <nav aria-label="Mobile">
      {nav.map((n) => <a href={u(n.href)} class:list={[{ active: isActive(n.href) }]}>{n.label}</a>)}
    </nav>
    <a class="btn btn-orange" href={wa("general")} target="_blank" rel="noopener">
      <Icon name="whatsapp" /> Chat via WhatsApp
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg, var(--sand));
    transition: background 0.3s, box-shadow 0.3s;
  }
  :global(body[data-tone="cream"]) .site-header { --header-bg: var(--cream); }
  :global(body[data-tone="paper"]) .site-header { --header-bg: var(--paper); }
  .site-header.scrolled {
    background: color-mix(in srgb, var(--header-bg, var(--sand)) 88%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: 0 1px 0 var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 76px;
  }
  .brand { flex: none; display: flex; align-items: center; gap: 0.6rem; }
  .brand :global(img) { width: 48px; height: 48px; }
  .brand-text { font-size: 0.78rem; line-height: 1.1; font-weight: 600; color: var(--navy); }
  .brand-text b { font-weight: 800; letter-spacing: 0.02em; }

  .links { display: none; margin-inline: auto; gap: 0.25rem; }
  .links a {
    position: relative;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.5rem 0.85rem;
    color: var(--ink-soft);
    transition: color 0.2s;
  }
  .links a::after {
    content: "";
    position: absolute;
    left: 0.85rem; right: 0.85rem; bottom: 0.2rem;
    height: 3px; border-radius: 3px;
    background: var(--orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .links a:hover { color: var(--ink); }
  .links a:hover::after, .links a.active::after { transform: scaleX(1); }
  .links a.active { color: var(--ink); font-weight: 600; }

  /* Clareo-style underlined text CTA */
  .cta {
    display: none;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--navy);
    padding-bottom: 0.15rem;
    border-bottom: 3px solid var(--navy);
    transition: color 0.2s, border-color 0.2s;
  }
  .cta:hover { color: var(--orange); border-color: var(--orange); }

  .toggle {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: var(--navy);
    color: #fff;
    cursor: pointer;
  }
  .toggle :global(.i-close) { display: none; }
  .toggle[aria-expanded="true"] :global(.i-close) { display: block; }
  .toggle[aria-expanded="true"] :global(.i-open) { display: none; }

  .mobile { display: grid; gap: 1.25rem; padding-bottom: 1.5rem; }
  .mobile[hidden] { display: none; }
  .mobile nav { display: grid; }
  .mobile nav a {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }
  .mobile nav a.active { color: var(--orange); }

  @media (min-width: 960px) {
    .links, .cta { display: flex; }
    .toggle, .mobile { display: none !important; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]")!;
  const toggle = header.querySelector<HTMLButtonElement>("[data-toggle]")!;
  const panel = header.querySelector<HTMLElement>("[data-mobile]")!;
  toggle.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    panel.hidden = open;
  });
  const onScroll = () => header.classList.toggle("scrolled", window.scrollY > 12);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
